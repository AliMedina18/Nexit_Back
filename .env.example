# Nota de nomenclatura: ASP.NET Core traduce automáticamente variables de entorno con doble guion
# bajo ("__") a la jerarquía de configuración (ej. Jwt__Authority -> Jwt:Authority). Por eso las
# variables de abajo (salvo DATABASE_URL, que tiene un manejo especial en Infrastructure/DependencyInjection.cs)
# usan doble guion bajo: así funcionan de verdad si tu proveedor de despliegue las inyecta como variables
# de entorno reales, en vez de quedarse solo como documentación de un .env que nadie carga.

# Desarrollo local (appsettings.Development.json usa estos mismos valores por defecto).
# En local no pasa nada por usar el superusuario postgres: es tu propia base local, no la compartida.
DATABASE_URL=Host=localhost;Database=nexit_dev;Username=postgres;Password=postgres;Port=5432;SSL Mode=Disable

# Producción: usa el secreto DATABASE_URL del entorno con SSL Mode=Require, y el usuario nexit_app
# (creado con docs/schema/02_rol_aplicacion_minimo_privilegio.sql), NUNCA el superusuario postgres — ver H2.
# DATABASE_URL=Host=db.YOUR_PROJECT.supabase.co;Database=postgres;Username=nexit_app;Password=...;Port=5432;SSL Mode=Require

Jwt__Authority=https://YOUR_PROJECT.supabase.co/auth/v1
Jwt__Audience=authenticated
# Dejar vacío si el proyecto Supabase usa claves de firma asimétricas (recomendado). Solo rellenar
# si el proyecto todavía usa el secreto compartido heredado (Settings > API > JWT Keys) — ver H1.
Jwt__LegacySharedSecret=
ASPNETCORE_ENVIRONMENT=Development
